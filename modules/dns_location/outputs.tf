output "id" {
  description = "UUID of the DNS location. What a DNS policy scoped to this location names, and what the gateway module's match.dns_location_ids takes."
  value       = cloudflare_zero_trust_dns_location.this.id
}

output "name" {
  description = "Display name of the location."
  value       = cloudflare_zero_trust_dns_location.this.name
}

output "doh_subdomain" {
  description = "The location's unique subdomain, generated by Cloudflare. The DoH and DoT endpoints hang off it."
  value       = cloudflare_zero_trust_dns_location.this.doh_subdomain
}

output "doh_url" {
  description = "DNS over HTTPS URL for the location, for a browser or OS resolver setting. Null until Cloudflare has generated the subdomain."
  value       = cloudflare_zero_trust_dns_location.this.doh_subdomain == null ? null : "https://${cloudflare_zero_trust_dns_location.this.doh_subdomain}.cloudflare-gateway.com/dns-query"
}

output "dot_hostname" {
  description = "DNS over TLS hostname for the location (port 853), for a router or Android Private DNS setting."
  value       = cloudflare_zero_trust_dns_location.this.doh_subdomain == null ? null : "${cloudflare_zero_trust_dns_location.this.doh_subdomain}.cloudflare-gateway.com"
}

output "ipv4_destination" {
  description = "Primary IPv4 resolver address for the location - what a site router's DNS setting points at."
  value       = cloudflare_zero_trust_dns_location.this.ipv4_destination
}

output "ipv4_destination_backup" {
  description = "Secondary IPv4 resolver address for the location."
  value       = cloudflare_zero_trust_dns_location.this.ipv4_destination_backup
}

output "ipv6_destination" {
  description = "The IPv6 resolver address unique to this location."
  value       = cloudflare_zero_trust_dns_location.this.ip
}
